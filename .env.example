# Copy to .env and fill in. Phase 1 needs NONE of these (pure core, no I/O).
# Required starting at the Setup transport smoke test and Phase 2.
#
# This resource exposes TWO host names for the same key: the classic
# *.openai.azure.com host (used for the realtime endpoint) and the newer
# *.services.ai.azure.com host (used for the Responses/Astra endpoint).

# --- Azure OpenAI (one key for both deployments) ---
AZURE_OPENAI_API_KEY=

# gpt-realtime voice brain (global realtime deployment)
AZURE_REALTIME_ENDPOINT=wss://<resource>.openai.azure.com/openai/v1/realtime?model=<deployment>
AZURE_REALTIME_DEPLOYMENT=      # e.g. gpt-realtime-2.1
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com

# Astra assessor (text deployment)
AZURE_ASTRA_ENDPOINT=https://<resource>.services.ai.azure.com/openai/v1/responses
AZURE_ASTRA_DEPLOYMENT=         # e.g. gpt-6-astra

# --- LiveKit (transport) ---
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Tavus (Phase 3 avatar, cosmetic) ---
TAVUS_API_KEY=

# --- Feature flags ---
AVATAR_ENABLED=false           # Phase 3: off => runs exactly as Phase 2 (audio only)

# --- Optional demo overrides (seconds) ---
# Lower these to show the TIMER door on camera without a long silence.
# Unset => real defaults (INTRO 90s, PAST_EXPERIENCE 150s).
# INTRO_TIME_LIMIT=20
# PAST_TIME_LIMIT=30
